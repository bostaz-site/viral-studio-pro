# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── OpenAI (Whisper) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── ElevenLabs (phase 2 — TTS) ──────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_BASE_URL=https://your-instance.app.n8n.cloud
N8N_API_KEY=your_n8n_api_key_here

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_PRICE_PRO=price_xxxxx
STRIPE_PRICE_STUDIO=price_xxxxx

# ── Social Auth — TikTok ─────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# ── Social Auth — Instagram ───────────────────────────────────────────────────
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here

# ── Social Auth — YouTube ─────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# ── Twitch API ────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# ── Security ──────────────────────────────────────────────────────────────────
ENCRYPTION_SECRET=generate_a_64_char_hex_string
CRON_SECRET=your_cron_secret_here

# ── VPS Rendering Server ─────────────────────────────────────────────────────
VPS_RENDER_URL=https://your-vps-ip:4000
VPS_RENDER_API_KEY=your_vps_api_key_here

# ── Render webhook (VPS → Next.js) ───────────────────────────────────────────
# WEBHOOK_SECRET = HMAC secret shared with the VPS for signing /api/render/hook
# WEBHOOK_HMAC_ONLY = "true" rejects any unsigned webhook (recommended in prod)
WEBHOOK_SECRET=generate_a_random_64_char_hex_string
WEBHOOK_HMAC_ONLY=true

# ── Upstash Redis (rate limiting + caching) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Newsletter (privacy-preserving IP hashing) ───────────────────────────────
NEWSLETTER_IP_SALT=generate_a_random_string_used_to_hash_subscriber_ips

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated list of emails that get admin panel access
ADMIN_EMAILS=samycloutier30@gmail.com

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error  (default: info)
LOG_LEVEL=info

# ── Sentry observability ─────────────────────────────────────────────────────
# Server-side DSN (logs from API routes + cron)
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/your_project_id
# Client-side DSN (browser errors, must be public)
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/your_project_id
# Source-map upload during build (only set for production builds)
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
SENTRY_AUTH_TOKEN=your_sentry_auth_token_for_sourcemap_upload

# ── Render queue tuning ──────────────────────────────────────────────────────
# How many concurrent renders the queue dispatches (default: 3)
RENDER_MAX_CONCURRENT=3

# ── Audit Mode ────────────────────────────────────────────────────────────────
# AUDIT_MODE: hides streamer-clip-browsing features during TikTok review.
# Set to "true" during audit, "false" or unset for normal operation.
NEXT_PUBLIC_AUDIT_MODE=false

# ── Pre-Launch Mode ────────────────────────────────────────────────────────────
# Skip user behavior findings until site has real users (~100 signups)
PRE_LAUNCH_MODE=true

# ── TikTok Review Safeguard ────────────────────────────────────────────────────
# Set to "true" during TikTok API review to pause auto-fix execution.
# Auto-fixes are queued and resume when set back to "false".
TIKTOK_REVIEW_MODE=false

# ── Night Audit Agent ──────────────────────────────────────────────────────────
DISCORD_AUDIT_WEBHOOK_URL=
AUDIT_CRON_SECRET=generate_a_random_string_for_audit_trigger
RESEND_API_KEY=

# ── Discord Bot (interactive buttons) ─────────────────────────────────────────
# Bot token from Discord Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=
# App ID from Discord Developer Portal → General Information
DISCORD_APP_ID=
# Public key for interaction signature verification
DISCORD_PUBLIC_KEY=
# Channel IDs (right-click channel → Copy Channel ID with Developer Mode on)
# Audit
DISCORD_CRITICAL_ALERTS_CHANNEL_ID=
DISCORD_MORNING_BRIEF_CHANNEL_ID=
DISCORD_PRODUCTION_ERRORS_CHANNEL_ID=
# Business
DISCORD_NEW_SIGNUPS_CHANNEL_ID=
DISCORD_NEW_PAID_CHANNEL_ID=
DISCORD_CHURN_ALERTS_CHANNEL_ID=
DISCORD_STRIPE_EVENTS_CHANNEL_ID=
DISCORD_WEEKLY_STATS_CHANNEL_ID=
# Acquisition
DISCORD_COLD_EMAIL_REPLIES_CHANNEL_ID=
DISCORD_POSITIVE_REPLIES_CHANNEL_ID=
DISCORD_PROMO_CODES_CHANNEL_ID=
DISCORD_CONVERSIONS_CHANNEL_ID=
DISCORD_INFLUENCER_STATUS_CHANNEL_ID=

# ── GitHub (auto-fix workflow) ────────────────────────────────────────────────
# PAT with repo + workflow scopes (for repository_dispatch + PR creation)
GITHUB_TOKEN=

# ── Cold Email (Instantly) ────────────────────────────────────────────────────
# API key from Instantly Settings → API Keys (optional, agent works without it)
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# En production, remplace par ton URL Netlify ou domaine custom
NEXT_PUBLIC_APP_URL=https://viralanimal.com
